<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Sdcb.PaddleInference" Version="3.3.1" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <Compile Include="..\Shared\OcrOrientationReport.cs" Link="OcrOrientationReport.cs" />
    <None Update="models\PP-LCNet_x1_0_doc_ori\inference.*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="models\PP-LCNet_x1_0_doc_ori\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckOrientationModel" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\models\PP-LCNet_x1_0_doc_ori\inference.json') Or !Exists('$(MSBuildProjectDirectory)\models\PP-LCNet_x1_0_doc_ori\inference.pdiparams')"
           Text="Direction model missing. Run: powershell -File samples/OcrOrientationWorker/Get-OrientationModel.ps1" />
  </Target>
</Project>
